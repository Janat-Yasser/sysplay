<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 22 22'><rect x='1' y='1' width='20' height='20' rx='5' fill='%232563EB'/><path d='M6 8l3.5 3L6 14' stroke='white' stroke-width='2' fill='none'/><path d='M11.5 14.5H16' stroke='white' stroke-width='2'/></svg>">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="nav-logo" aria-label="Systems Playground home">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><rect x="1" y="1" width="20" height="20" rx="5" fill="#F59E0B"/><path d="M6 8l3.5 3L6 14" stroke="#1C1917" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M11.5 14.5H16" stroke="#1C1917" stroke-width="2" stroke-linecap="round"/></svg>
      <span>Systems Playground</span>
    </a>
    <div class="nav-links">
      <a href="/compression" class="nav-link <%= title.includes('Huffman') ? 'active' : '' %>"><span class="nav-link-dot"></span>Compression</a>
      <a href="/database" class="nav-link <%= title.includes('Key-Value') ? 'active' : '' %>"><span class="nav-link-dot"></span>Database</a>
      <a href="/network" class="nav-link <%= title.includes('Network') ? 'active' : '' %>"><span class="nav-link-dot"></span>Network</a>
    </div>
  </nav>

  <main><%- body %></main>

  <footer class="footer">
    <div class="footer-inner">
      <span>Systems Playground</span>
      <span>Real implementations, not canned animations. Node.js and Express.</span>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
