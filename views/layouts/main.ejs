<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preload" href="/fonts/vt323-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23030904'/><path d='M7 10l7 6-7 6' stroke='%2366FF8C' stroke-width='3' fill='none'/><rect x='16' y='20' width='10' height='3' fill='%2366FF8C'/></svg>">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="nav-logo" aria-label="Systems Playground home">
      <span aria-hidden="true">&gt;_</span><span>sysplay</span>
    </a>
    <div class="nav-links">
      <a href="/compression" class="nav-link <%= title.includes('Huffman') ? 'active' : '' %>"><span class="nav-link-dot"></span>Compression</a>
      <a href="/database" class="nav-link <%= title.includes('Key-Value') ? 'active' : '' %>"><span class="nav-link-dot"></span>Database</a>
      <a href="/network" class="nav-link <%= title.includes('Network') ? 'active' : '' %>"><span class="nav-link-dot"></span>Network</a>
    </div>
  </nav>

  <main><%- body %></main>

  <footer class="footer">
    <div class="footer-inner">
      <span>Systems Playground</span>
      <span>Real implementations, not canned animations. Node.js and Express.</span>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
